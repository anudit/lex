{
  "name": "lex-large",
  "version": "0.1.0",
  "description": "Language-agnostic syntax highlighting from a 106.77 KiB neural model running on WebGPU, covering 193 Highlight.js grammars",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./react": "./src/react.js",
    "./tokenizer": "./src/tokenizer.js",
    "./runtime": "./src/runtime.js",
    "./theme.css": "./src/theme.css",
    "./shader.wgsl": "./src/shader.wgsl",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "syntax-highlighting",
    "webgpu",
    "wgsl",
    "neural",
    "lexer"
  ],
  "engines": {
    "node": ">=18"
  }
}
